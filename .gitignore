/.local/
/target/
# The vendored crates in third_party/ are their own packages (excluded from
# the workspace), so building one standalone makes a target/ beside it.
third_party/*/target/
third_party/*/Cargo.lock
**/__pycache__/
*.py[cod]
/.venv/
# Downloaded/decompiled game content and private profiling artifacts.
*.jar
*.class
*.jfr
*.hprof
/decompiled/
/minecraft/
/assets/
/run/
/logs/
/dist/
/mods/horizon/build/
/saves/
/backups/
/tools/logs/
.DS_Store
# What the client writes to its working directory when run from the repo root.
/options.txt
/debug-profile.json
/horizon.txt
/horizon-graphics.txt
/horizon-controller.txt
/horizon-extras.txt
/horizon-player.txt
/servers.dat
/screenshots/
/.horizon-cache/
/crash-reports/
/debug/

# Release-only compiled original exporter bundle.
/exporters/
